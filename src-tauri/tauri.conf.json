{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuantsMind Studio",
  "version": "0.1.0",
  "identifier": "com.quantsmind.studio",
  "withGlobalTauri": true,
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "QuantsMind Relational Studio",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  }
}